# 실제 값은 서버의 .env에만 보관하세요. 이 예제에는 비밀을 넣지 마세요.
BOT_TOKEN=
BOT_DB_KEY=
# 처음에는 비워 두고 봇의 /setup으로 본인 ID 확인 후 추가하고 재시작하세요.
BOT_ALLOWED_IDS=
BOT_USERS_DIR=data/users
# 조회 후 대기는 myTrail과 같은 감마분포(평균 6.5초)로 매번 정합니다.
# 사용자 계정과 카드는 텔레그램 /setup, /cards에서 등록합니다.
# 예약 전 카드 선택 시 확보 후 평균 3분 감마분포 대기 뒤 자동결제.
# '수동 결제'는 확보 후 결제 확인. 코레일 결제기한이 짧으면 자동결제 대기를 줄입니다.
